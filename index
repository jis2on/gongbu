<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>기초학력 단계별 문제 생성기</title>
<style>
:root{--bg:#f4f5f7;--card:#fff;--line:#dfe3e8;--ink:#1d2733;--sub:#5d6875;--ac:#2563c9;--ac2:#e9f0fc;--ok:#1d7a46;--warn:#a5530a;--warnbg:#fff6e8}
*{box-sizing:border-box}
body{margin:0;font-family:"Pretendard","Apple SD Gothic Neo","Malgun Gothic","맑은 고딕",sans-serif;background:var(--bg);color:var(--ink);font-size:14px;line-height:1.5}
header{background:#1e2a3f;color:#fff;padding:14px 22px;display:flex;align-items:baseline;gap:14px;flex-wrap:wrap}
header h1{font-size:18px;margin:0;font-weight:700}
header span{opacity:.75;font-size:12.5px}
.layout{display:grid;grid-template-columns:270px minmax(0,1fr);gap:16px;padding:16px;max-width:1440px;margin:0 auto}
@media(max-width:900px){.layout{grid-template-columns:1fr}}
.card{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:14px 16px;margin-bottom:14px}
.card h2{font-size:15px;margin:0 0 10px;display:flex;align-items:center;gap:8px}
.card h2 small{font-weight:400;color:var(--sub);font-size:12px}
.muted{color:var(--sub);font-size:12.5px}
input[type=text],input[type=number],select,textarea{font:inherit;border:1px solid #c9d0d8;border-radius:6px;padding:6px 8px;background:#fff;color:inherit}
textarea{width:100%;resize:vertical;min-height:38px}
button{font:inherit;border:1px solid #c9d0d8;background:#fff;border-radius:6px;padding:6px 12px;cursor:pointer;color:inherit}
button:hover{background:#f1f3f6}
button.pri{background:var(--ac);border-color:var(--ac);color:#fff;font-weight:600}
button.pri:hover{background:#1d52a8}
button.sm{padding:3px 8px;font-size:12px}
button.danger{color:#b42318}
.row{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.stu-list{list-style:none;margin:8px 0 0;padding:0;max-height:52vh;overflow:auto}
.stu-list li{display:flex;align-items:center;justify-content:space-between;padding:7px 9px;border-radius:7px;cursor:pointer;gap:6px}
.stu-list li:hover{background:#f1f3f6}
.stu-list li.on{background:var(--ac2);font-weight:600}
.stu-list .cnt{font-size:11.5px;color:var(--sub);font-weight:400}
.subj-table{width:100%;border-collapse:collapse}
.subj-table th,.subj-table td{border-bottom:1px solid var(--line);padding:8px 6px;vertical-align:top;text-align:left}
.subj-table th{font-size:12.5px;color:var(--sub);font-weight:600}
.subj-table td.sname{font-weight:700;width:52px;padding-top:12px}
.chips{display:flex;flex-wrap:wrap;gap:5px;margin-top:5px}
.chip{display:inline-block;background:var(--ac2);color:#1d4f9c;border-radius:20px;padding:1px 9px;font-size:12px}
.chip.ok{background:#e7f6ec;color:var(--ok)}
.topic-box{display:flex;flex-wrap:wrap;gap:6px;margin:6px 0}
.topic-box label{border:1px solid #c9d0d8;border-radius:20px;padding:3px 11px;cursor:pointer;font-size:13px;user-select:none}
.topic-box label.on{background:var(--ac);border-color:var(--ac);color:#fff}
.topic-box input{display:none}
.topic-box label.exam{border-color:#c98a1c}
.topic-box label.exam.on{background:#b26f00;border-color:#b26f00}
.grid2{display:grid;grid-template-columns:110px 1fr;gap:9px 12px;align-items:center}
.notice{background:var(--warnbg);border:1px solid #f3d29b;color:var(--warn);padding:8px 12px;border-radius:7px;margin:8px 0;font-size:13px}
.notice.info{background:#eef5ff;border-color:#c5d9f6;color:#1d4f9c}
.toast{position:fixed;bottom:20px;left:50%;transform:translateX(-50%);background:#1e2a3f;color:#fff;padding:9px 18px;border-radius:8px;font-size:13.5px;opacity:0;transition:.25s;pointer-events:none;z-index:99}
.toast.show{opacity:1}
details summary{cursor:pointer;font-weight:600}
.help li{margin-bottom:4px}
#previewWrap{background:#e9ebef;border-radius:10px;padding:16px;overflow:auto}
.empty{color:var(--sub);text-align:center;padding:40px 10px}
/* ===== 학습지 ===== */
.sheet{background:#fff;width:210mm;max-width:100%;margin:0 auto 16px;padding:14mm 13mm;box-shadow:0 1px 4px rgba(0,0,0,.12);color:#111;font-size:10.5pt;line-height:1.55}
.sh-head{border-bottom:2px solid #222;padding-bottom:6px;margin-bottom:10px}
.sh-title{font-size:15pt;font-weight:800}
.sh-title .lv{font-size:10.5pt;font-weight:600;border:1px solid #333;border-radius:4px;padding:0 6px;margin-left:6px;vertical-align:middle}
.sh-meta{display:flex;justify-content:space-between;gap:10px;margin-top:5px;font-size:10pt;flex-wrap:wrap}
.sh-topics{font-size:9pt;color:#555;margin-top:3px}
ol.qs{margin:0;padding-left:0;list-style:none;columns:2;column-gap:9mm;column-rule:1px solid #ddd}
ol.qs li.q{break-inside:avoid;page-break-inside:avoid;margin:0 0 4.5mm;display:block}
.qn{font-weight:800;margin-right:4px}
.qbox{border:1px solid #999;padding:4px 8px;margin:4px 0;border-radius:3px;background:#fafafa}
.sys{display:inline-block;border-left:2px solid #333;padding:2px 10px;margin:4px 0 0 6px;line-height:1.8}
.chs{margin-top:3px}
.ch{display:inline-block;margin-right:14px}
.chs.col .ch{display:block;margin:1px 0}
.ansline{margin-top:5px}
.ansline span{display:inline-block;border-bottom:1px solid #444;width:42mm;height:1.1em}
.gap{letter-spacing:0;white-space:nowrap}
.hint{color:#444}
.en{font-family:"Times New Roman",Georgia,serif;font-size:11.5pt}
.pron{color:#555;font-size:9.5pt}
.reused{font-size:8pt;color:#a5530a}
.anst{width:100%;border-collapse:collapse;font-size:9.5pt}
.anst th,.anst td{border:1px solid #888;padding:3px 6px;text-align:left;vertical-align:top}
.anst th{background:#f0f0f0}
.voc{width:100%;border-collapse:collapse;font-size:10pt}
.voc th,.voc td{border:1px solid #888;padding:3px 6px}
.voc th{background:#f0f0f0}
.voc td.c{text-align:center}
.wrapt{width:100%;border-collapse:collapse}
.wrapt>tbody>tr>td{vertical-align:top;padding:0 2mm;width:50%}
.pb{break-before:page;page-break-before:always;height:0}
@media print{
  @page{size:A4;margin:12mm 11mm}
  body{background:#fff}
  header,.no-print,aside,.toast{display:none!important}
  .layout{display:block;padding:0;max-width:none}
  .card{border:0;padding:0;margin:0}
  #previewWrap{background:#fff;padding:0;border-radius:0;overflow:visible}
  .sheet{box-shadow:none;margin:0;width:auto;padding:0}
}
</style>
</head>
<body>
<header><h1>기초학력 단계별 문제 생성기</h1><span>국어 · 영어 · 수학 · 과학 · 역사 | 중학교 2학년 기초학력 보충용</span></header>
<div class="layout">
<aside class="no-print">
  <div class="card">
    <h2>학생 명단</h2>
    <div class="row"><input id="newNo" type="number" min="1" placeholder="번호" style="width:64px"><input id="newName" type="text" placeholder="이름(가명 권장)" style="flex:1;min-width:0"></div>
    <div class="row" style="margin-top:6px"><button class="pri" id="addStu" style="flex:1">학생 추가</button></div>
    <div class="row" style="margin-top:6px"><textarea id="bulkNames" rows="2" placeholder="여러 명 한꺼번에: 한 줄에 한 명씩 (예: 1 학생A)"></textarea></div>
    <div class="row" style="margin-top:4px"><button class="sm" id="bulkAdd">여러 명 추가</button></div>
    <ul class="stu-list" id="stuList"></ul>
    <p class="muted" style="margin:8px 0 0">실명 대신 번호나 가명을 쓰세요. 민감한 정보(가정환경, 진단명 등)는 적지 않는 것이 좋아요.</p>
  </div>
  <div class="card">
    <h2>저장 · 백업</h2>
    <p class="muted" id="storeMsg" style="margin:0 0 8px">입력한 내용은 이 브라우저에 자동 저장돼요.</p>
    <div class="row"><button class="sm" id="exportBtn">백업 파일 저장</button><button class="sm" id="importBtn">백업 불러오기</button><input type="file" id="importFile" accept=".json" style="display:none"></div>
  </div>
  <div class="card">
    <details class="help"><summary>사용 방법</summary>
    <ol style="padding-left:18px;margin:8px 0 0;font-size:13px">
      <li>왼쪽에서 학생을 추가하고 선택해요.</li>
      <li>과목별 <b>수준</b>과 <b>학생 특징</b>을 적어요. 특징에 맞는 출제 주제가 자동으로 추천돼요.</li>
      <li>‘문제지 만들기’에서 과목을 고르고 <b>문제 만들기</b>를 눌러요.</li>
      <li><b>인쇄 / PDF 저장</b> 또는 <b>Word 파일 다운로드</b>를 눌러요. 이때 출제 기록이 저장되고, 다음에는 이 문항이 빠져요.</li>
      <li>여러 학생에게 한꺼번에 나눠 줄 때는 ‘여러 학생 한꺼번에’를 사용해요.</li>
    </ol></details>
  </div>
</aside>
<main>
  <div class="card no-print" id="stuPanel"></div>
  <div class="card no-print" id="genPanel">
    <h2>문제지 만들기 <small id="genFor"></small></h2>
    <div class="grid2">
      <div>과목</div><div class="row" id="subBtns"></div>
      <div id="kindLbl">자료 종류</div><div class="row" id="kindRow">
        <label><input type="radio" name="kind" value="quiz" checked> 문제지</label>
        <label><input type="radio" name="kind" value="vocab"> 단어장 (50개)</label>
        <label id="vtestLbl"><input type="checkbox" id="vtest" checked> 단어 확인 시험지 함께 만들기</label>
      </div>
      <div>수준</div><div class="row"><select id="lvSel"></select><span class="muted" id="lvHint"></span></div>
      <div id="topicLbl">출제 주제</div><div><div class="topic-box" id="topicBox"></div>
        <div class="row"><button class="sm" id="autoTopic">학생 특징에 맞게 선택</button><button class="sm" id="allTopic">전체 선택</button><button class="sm" id="examTopic" style="display:none"></button><button class="sm" id="baseTopic" style="display:none">기초 학습 주제만</button><span class="muted" id="topicMsg"></span></div></div>
      <div id="cntLbl">문항 수</div><div class="row" id="cntRow"><select id="cntSel"><option>10</option><option>20</option><option selected>30</option></select></div>
      <div>선택</div><div class="row" style="gap:14px">
        <label><input type="checkbox" id="optEx" checked> 전에 풀었던 문제(배부한 단어) 빼기</label>
        <label><input type="checkbox" id="optAns" checked> 정답지 함께 만들기</label>
        <label><input type="checkbox" id="optRec" checked> 인쇄·다운로드할 때 출제 기록 저장</label>
      </div>
    </div>
    <div class="row" style="margin-top:12px"><button class="pri" id="genBtn">문제 만들기</button></div>
  </div>
  <div class="card no-print">
    <details id="batchBox"><summary>여러 학생 한꺼번에 만들기 <span class="muted">(학생마다 각자의 수준·특징·출제 기록을 반영)</span></summary>
      <div style="margin-top:10px" class="grid2">
        <div>학생</div><div><div class="row" id="batchStu"></div><div class="row" style="margin-top:4px"><button class="sm" id="batchAll">모두 선택</button><button class="sm" id="batchNone">선택 해제</button></div></div>
        <div>과목</div><div class="row"><select id="batchSub"></select>
          <span id="batchKindWrap"><label><input type="radio" name="bkind" value="quiz" checked> 문제지</label> <label><input type="radio" name="bkind" value="vocab"> 단어장</label></span></div>
      </div>
      <div class="row" style="margin-top:10px"><button class="pri" id="batchBtn">선택한 학생 문제지 만들기</button></div>
    </details>
  </div>
  <div class="card" id="outCard">
    <div class="row no-print" id="outBar" style="margin-bottom:8px;display:none">
      <button class="pri" id="printBtn">인쇄 / PDF 저장</button>
      <button id="wordBtn">Word 파일 다운로드</button>
      <button id="recBtn">출제 기록에 저장</button>
      <button id="regenBtn">다시 만들기</button>
      <span class="muted" id="recMsg"></span>
    </div>
    <div class="no-print" id="noteArea"></div>
    <div id="previewWrap"><div class="empty">학생과 과목을 고르고 ‘문제 만들기’를 누르면 여기에 학습지가 나타나요.</div></div>
  </div>
</main>
</div>
<div class="toast" id="toast"></div>
<script>
/* ===================== 공통 ===================== */
const LV4=['기초','하','중','상'];
const LV9=['초등 하','초등 중','초등 상','중1 하','중1 중','중1 상','중2 하','중2 중','중2 상'];
const SUB_LIST=['국어','영어','수학','과학','역사'];
const SUBJECTS={'국어':LV4,'영어':LV9,'수학':LV9,'과학':LV4,'역사':LV4};
const CIRC=['①','②','③','④','⑤'];
const M='−';
const R={
  ri:(a,b)=>a+Math.floor(Math.random()*(b-a+1)),
  pick:a=>a[Math.floor(Math.random()*a.length)],
  shuffle(a){a=a.slice();for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]];}return a;},
  sample(a,n){return R.shuffle(a).slice(0,n);},
  nz(a,b){let v=0;while(v===0)v=R.ri(a,b);return v;}
};
const uniq=a=>[...new Set(a)];
const gcd=(a,b)=>{a=Math.abs(a);b=Math.abs(b);while(b){[a,b]=[b,a%b];}return a;};
const lcm=(a,b)=>a/gcd(a,b)*b;
const num=n=>n<0?M+(-n):String(n);
const pn=n=>n<0?'('+M+(-n)+')':String(n);
const sgnd=n=>n<0?'('+M+(-n)+')':'(+'+n+')';
function frac(n,d){if(d<0){n=-n;d=-d;}const g=gcd(n,d)||1;n/=g;d/=g;if(d===1)return num(n);return (n<0?M:'')+Math.abs(n)+'/'+d;}
function fracMixed(n,d){ // 초등용: 약분 + 가분수면 대분수 병기
  const g=gcd(n,d);n/=g;d/=g;if(d===1)return String(n);
  if(n>d)return `${n}/${d} (= ${Math.floor(n/d)}과 ${n%d}/${d})`;return `${n}/${d}`;}
function decStr(v,p){const neg=v<0;v=Math.abs(v);let s=String(v).padStart(p+1,'0');let ip=s.slice(0,s.length-p),fp=s.slice(s.length-p).replace(/0+$/,'');return (neg?M:'')+ip+(fp?'.'+fp:'');}
const sup=(b,e)=>e===1?b:`${b}<sup>${e}</sup>`;
function poly(terms){let s='';for(const [c,v] of terms){if(c===0)continue;const a=Math.abs(c);const body=v?((a===1?'':a)+v):String(a);if(s==='')s=(c<0?M:'')+body;else s+=(c<0?' '+M+' ':' + ')+body;}return s===''?'0':s;}
function mono(c,v,e){if(c===0)return '0';const cs=c===1?'':c===-1?M:num(c);return cs+sup(v,e);}
const FLIP={'>':'<','<':'>','≥':'≤','≤':'≥'};
function nc(lv){const i4=LV4.indexOf(lv);if(i4>=0)return [3,4,4,5][i4];const i9=LV9.indexOf(lv);return i9<=1?3:(i9===8?5:4);}

function mc(id,q,correct,distractors,n,exp){
  const ds=uniq(distractors.filter(d=>d!==correct&&d!=null));
  const opts=R.shuffle([correct,...R.sample(ds,Math.max(1,n-1))]);
  if(opts.length<2)return null;
  return {id,type:'mc',q,choices:opts,ans:opts.indexOf(correct),exp};
}
function mcFixed(id,q,choices,ansIdx,exp){return {id,type:'mc',q,choices,ans:ansIdx,exp};}
function sa(id,q,ans,exp){return {id,type:'sa',q,ans:String(ans),exp};}
const box=t=>`<div class="qbox">${t}</div>`;

const GENS={'국어':[],'영어':[],'수학':[],'과학':[],'역사':[]};
function G(sub,topic,levels,fn,w){GENS[sub].push({topic,levels,fn,w:w||1});}

/* 4단계 과목: 해당 수준 70%, 아래 수준 30% */
function lvIdx(lv){return LV4.indexOf(lv);}
function pickLv(arr,lv,filter){
  const L=lvIdx(lv);const a=filter?arr.filter(filter):arr;
  const ex=a.filter(x=>lvIdx(x.lv)===L),lo=a.filter(x=>lvIdx(x.lv)<L);
  if(ex.length&&(!lo.length||Math.random()<0.7))return R.pick(ex);
  if(lo.length)return R.pick(lo);return null;
}
const upTo=(arr,lv,plus)=>arr.filter(x=>lvIdx(x.lv)<=lvIdx(lv)+(plus||0));

/* ===================== 생성 엔진 ===================== */
function topicsFor(sub,lv){return uniq(GENS[sub].filter(g=>g.levels.includes(lv)).map(g=>g.topic));}
function generate(sub,lv,opt){
  const n=opt.n||30,exclude=opt.exclude||new Set();
  let gens=GENS[sub].filter(g=>g.levels.includes(lv));
  if(opt.topics&&opt.topics.length)gens=gens.filter(g=>opt.topics.includes(g.topic));
  const notes=[];
  if(!gens.length)return {items:[],notes:['선택한 주제에 해당하는 문항이 없습니다.']};
  const byT={};gens.forEach(g=>{(byT[g.topic]=byT[g.topic]||[]).push(g);});
  const topics=Object.keys(byT);
  const items=[],ids=new Set(),gcnt=new Map();const cap=Math.max(2,Math.ceil(n/gens.length)+1);
  const run=(useEx)=>{
    const fails={};let ti=0,att=0;
    while(items.length<n&&att<n*400){
      att++;const live=topics.filter(t=>(fails[t]||0)<150);if(!live.length)break;
      const t=live[ti++%live.length];const gs=byT[t];
      const tot=gs.reduce((s,g)=>s+g.w,0);let r=Math.random()*tot,g=gs[0];
      for(const x of gs){r-=x.w;if(r<=0){g=x;break;}}
      if((gcnt.get(g)||0)>=cap&&att<n*200){fails[t]=(fails[t]||0)+1;continue;}
      let it=null;try{it=g.fn(lv);}catch(e){it=null;}
      if(!it||ids.has(it.id)||(useEx&&exclude.has(it.id))){fails[t]=(fails[t]||0)+1;continue;}
      fails[t]=0;gcnt.set(g,(gcnt.get(g)||0)+1);it.topic=t;if(!useEx)it.reused=exclude.has(it.id);ids.add(it.id);items.push(it);
    }
  };
  run(true);
  if(items.length<n&&exclude.size){const before=items.length;run(false);const k=items.filter(x=>x.reused).length;if(k)notes.push(`새 문항이 부족해서 이전에 출제한 문항 ${k}개를 다시 넣었어요. 주제를 더 선택하거나 다른 수준을 골라 보세요.`);}
  if(items.length<n)notes.push(`선택한 주제에서 만들 수 있는 문항이 ${items.length}개뿐이에요. 주제를 더 선택해 주세요.`);
  const order=topics;items.sort((a,b)=>order.indexOf(a.topic)-order.indexOf(b.topic));
  return {items,notes};
}

/* ===================== 수학 ===================== */
const NAMES=['민수','지아','하나','유나','수아','지호','도하','서아'];
const MS='수학';
// 초등 하
G(MS,'덧셈',['초등 하'],()=>{const a=R.ri(12,79),b=R.ri(12,99-a);return sa(`m-add-${a}-${b}`,`${a} + ${b} =`,a+b);});
