G(HS,HT6,LV4,lv=>{const x=pickLv(HX,lv,y=>y.y!=null);if(!x)return null;const ds=uniq(HX.filter(y=>y.y!=null&&Math.abs(y.y-x.y)>=5).map(y=>`${y.y}년`));return mc(`w-yr-${x.n}`,`다음 일이 일어난 해는?${box(`${x.c==='국제'?'':x.c+': '}${x.n}`)}`,`${x.y}년`,ds,ncH(lv));});
EXAM_TOPICS['역사']=[HT1,HT2,HT3,HT4,HT5,HT6];EXAM_LABEL['역사']='비상 역사① 5-1~6-2';
Object.assign(KW['역사'],{[HT1]:'시민 혁명|프랑스 혁명|미국 독립|국민 국가|세계사|시험',[HT2]:'산업 혁명|제국주의|세계사|시험',[HT3]:'아시아|중국|청|일본|인도|근대화|세계사|시험',[HT4]:'세계 대전|대공황|전체주의|민족 운동|세계사|시험',[HT5]:'인권|평화|국제 연합|세계사|시험',[HT6]:'순서|흐름|연도|연표|시기|시험'});

</script>
<script>
/* ===================== 화면 ===================== */
const $=id=>document.getElementById(id);
const esc=s=>String(s==null?'':s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const strip=s=>String(s).replace(/<[^>]+>/g,'');
const STORE='basic-skills-tool-v1';
let state={students:[],selId:null};
let storageOK=true;
const PH={'국어':'예) 맞춤법을 자주 틀림, 글의 중심 내용 파악이 어려움','영어':'예) 단어를 잘 못 외움, be동사·과거형이 헷갈림','수학':'예) 분수 계산 실수가 많음, 문장제를 어려워함','과학':'예) 상태 변화 용어를 헷갈림, 속력 계산이 어려움','역사':'예) 시대 순서를 헷갈림, 조선 시대 인물을 잘 모름'};
const defLv=sub=>SUBJECTS[sub]===LV4?'하':'중2 하';

function load(){try{const s=localStorage.getItem(STORE);if(s){const o=JSON.parse(s);if(o&&Array.isArray(o.students))state=o;}}catch(e){storageOK=false;}}
function save(){try{localStorage.setItem(STORE,JSON.stringify(state));}catch(e){storageOK=false;}
  $('storeMsg').innerHTML=storageOK?'입력한 내용은 이 브라우저에 자동 저장돼요. 다른 컴퓨터에서 쓰려면 백업 파일을 저장하세요.':'<b style="color:#b42318">이 환경에서는 자동 저장이 되지 않아요.</b> 작업이 끝나면 꼭 ‘백업 파일 저장’을 눌러 주세요.';}
function toast(m){const t=$('toast');t.textContent=m;t.classList.add('show');clearTimeout(toast._t);toast._t=setTimeout(()=>t.classList.remove('show'),2200);}
function newStudent(no,name){const subjects={};SUB_LIST.forEach(s=>subjects[s]={level:defLv(s),note:''});return {id:'s'+Date.now().toString(36)+Math.random().toString(36).slice(2,6),no:no||'',name:name||'',subjects,history:{}};}
const cur=()=>state.students.find(s=>s.id===state.selId)||null;
const stuLabel=s=>s?`${s.no?s.no+'번 ':''}${s.name}`:'';
const histOf=(s,key)=>new Set((s&&s.history[key])||[]);

/* ---------- 학생 목록 ---------- */
function renderStudents(){
  const ul=$('stuList');state.students.sort((a,b)=>(+a.no||999)-(+b.no||999));
  ul.innerHTML=state.students.length?state.students.map(s=>{const n=SUB_LIST.reduce((t,k)=>t+((s.history[k]||[]).length),0);
    return `<li data-id="${s.id}" class="${s.id===state.selId?'on':''}"><span>${esc(stuLabel(s))}<br><span class="cnt">출제 기록 ${n}문항</span></span><button class="sm danger" data-del="${s.id}" title="삭제">×</button></li>`;}).join(''):'<li class="muted" style="cursor:default">아직 학생이 없어요.</li>';
  renderBatchStu();
}
$('stuList').onclick=e=>{const d=e.target.closest('[data-del]');if(d){const s=state.students.find(x=>x.id===d.dataset.del);if(s&&confirm(`${stuLabel(s)} 학생을 삭제할까요? 출제 기록도 함께 지워져요.`)){state.students=state.students.filter(x=>x!==s);if(state.selId===s.id)state.selId=null;save();renderAll();}return;}
  const li=e.target.closest('li[data-id]');if(li){state.selId=li.dataset.id;save();renderAll();}};
$('addStu').onclick=()=>{const name=$('newName').value.trim(),no=$('newNo').value.trim();if(!name&&!no){toast('번호나 이름을 입력하세요.');return;}
  const s=newStudent(no,name||`학생${no}`);state.students.push(s);state.selId=s.id;$('newName').value='';$('newNo').value=no?String(+no+1):'';save();renderAll();};
$('newName').onkeydown=e=>{if(e.key==='Enter')$('addStu').click();};
$('bulkAdd').onclick=()=>{const lines=$('bulkNames').value.split('\n').map(x=>x.trim()).filter(Boolean);if(!lines.length)return;
  lines.forEach(l=>{const m=l.match(/^(\d+)[\s.,)번]*\s*(.*)$/);const no=m?m[1]:'',name=m?(m[2]||`학생${m[1]}`):l;state.students.push(newStudent(no,name));});
  $('bulkNames').value='';if(!state.selId&&state.students[0])state.selId=state.students[0].id;save();renderAll();toast(`${lines.length}명을 추가했어요.`);};

/* ---------- 학생 상세 ---------- */
function renderStuPanel(){
  const s=cur(),p=$('stuPanel');
  if(!s){p.innerHTML='<h2>학생 정보</h2><p class="muted" style="margin:0">왼쪽에서 학생을 추가하거나 선택하세요. 학생을 고르지 않아도 문제지는 만들 수 있지만, 출제 기록은 남지 않아요.</p>';return;}
  p.innerHTML=`<h2>${esc(stuLabel(s))} <small>과목별 수준과 특징</small></h2>
  <div class="row" style="margin-bottom:6px"><span class="muted">번호</span><input type="number" id="edNo" value="${esc(s.no)}" style="width:70px"><span class="muted">이름</span><input type="text" id="edName" value="${esc(s.name)}" style="width:160px"></div>
  <table class="subj-table"><thead><tr><th>과목</th><th style="width:130px">수준</th><th>학생 특징 (어려워하는 부분)</th><th style="width:150px">출제 기록</th></tr></thead><tbody>
  ${SUB_LIST.map(sub=>{const o=s.subjects[sub];const m=matchTopics(sub,o.level,o.note);const h=(s.history[sub]||[]).length,hv=(s.history['영어단어']||[]).length;
    return `<tr><td class="sname">${sub}</td><td><select data-lv="${sub}">${SUBJECTS[sub].map(l=>`<option ${l===o.level?'selected':''}>${l}</option>`).join('')}</select></td>
    <td><textarea data-note="${sub}" rows="2" placeholder="${PH[sub]}">${esc(o.note)}</textarea><div class="chips" id="m-${sub}">${chipsFor(sub,o.level,o.note)}</div></td>
    <td class="muted">${h}문항${sub==='영어'?`<br>단어 ${hv}개`:''}<br><button class="sm" data-reset="${sub}" style="margin-top:4px">기록 지우기</button></td></tr>`;}).join('')}
  </tbody></table>`;
}
function chipsFor(sub,lv,note){const m=matchTopics(sub,lv,note);if(!note.trim())return '<span class="muted">특징을 적으면 맞는 출제 주제를 추천해요.</span>';
  return m.length?'<span class="muted">추천 주제:</span> '+m.map(t=>`<span class="chip ok">${t}</span>`).join(''):'<span class="muted">이 수준에서 딱 맞는 주제를 찾지 못했어요. 전체 주제로 출제해요.</span>';}
$('stuPanel').addEventListener('input',e=>{const s=cur();if(!s)return;const t=e.target;
  if(t.dataset.note){const sub=t.dataset.note;s.subjects[sub].note=t.value;$('m-'+sub).innerHTML=chipsFor(sub,s.subjects[sub].level,t.value);save();if(sub===G_.sub)autoTopics();}
  if(t.id==='edName'){s.name=t.value;save();renderStudents();renderGenFor();}
  if(t.id==='edNo'){s.no=t.value;save();renderStudents();renderGenFor();}});
$('stuPanel').addEventListener('change',e=>{const s=cur();if(!s)return;const t=e.target;
  if(t.dataset.lv){const sub=t.dataset.lv;s.subjects[sub].level=t.value;save();$('m-'+sub).innerHTML=chipsFor(sub,t.value,s.subjects[sub].note);if(sub===G_.sub){G_.lv=t.value;renderGen();autoTopics();}}});
$('stuPanel').addEventListener('click',e=>{const b=e.target.closest('[data-reset]');if(!b)return;const s=cur();const sub=b.dataset.reset;
  if(confirm(`${stuLabel(s)} 학생의 ${sub} 출제 기록을 지울까요? 지우면 이전 문제가 다시 나올 수 있어요.`)){delete s.history[sub];if(sub==='영어')delete s.history['영어단어'];save();renderAll();toast('출제 기록을 지웠어요.');}});

/* ---------- 문제지 설정 ---------- */
const G_={sub:'수학',lv:'중2 하',topics:new Set(),kind:'quiz'};
function renderGenFor(){const s=cur();$('genFor').textContent=s?`· ${stuLabel(s)}`:'· 학생 미지정 (출제 기록 없음)';}
function renderGen(){
  renderGenFor();
  $('subBtns').innerHTML=SUB_LIST.map(x=>`<button class="${x===G_.sub?'pri':''}" data-sub="${x}">${x}</button>`).join('');
  const levels=SUBJECTS[G_.sub];if(!levels.includes(G_.lv))G_.lv=levels[1];
  $('lvSel').innerHTML=levels.map(l=>`<option ${l===G_.lv?'selected':''}>${l}</option>`).join('');
  const s=cur();$('lvHint').textContent=s?(s.subjects[G_.sub].level===G_.lv?'학생 수준으로 설정됨':`학생 수준은 ${s.subjects[G_.sub].level}`):'';
  const eng=G_.sub==='영어';$('kindLbl').style.display=$('kindRow').style.display=eng?'':'none';
  if(!eng)G_.kind='quiz';document.querySelectorAll('input[name=kind]').forEach(r=>r.checked=r.value===G_.kind);
  const voc=G_.kind==='vocab';$('vtestLbl').style.display=voc?'':'none';
  ['topicLbl','cntLbl'].forEach(i=>$(i).style.visibility=voc?'hidden':'');$('topicBox').parentElement.style.display=voc?'none':'';$('cntRow').style.display=voc?'none':'';
  const hasEx=!!EXAM_TOPICS[G_.sub];$('examTopic').style.display=$('baseTopic').style.display=hasEx?'':'none';if(hasEx)$('examTopic').textContent=`시험 범위만: ${EXAM_LABEL[G_.sub]}`;
  renderTopics();
}
function renderTopics(){const av=topicsFor(G_.sub,G_.lv);[...G_.topics].forEach(t=>{if(!av.includes(t))G_.topics.delete(t);});if(!G_.topics.size)av.forEach(t=>G_.topics.add(t));
  const ex=EXAM_TOPICS[G_.sub]||[];$('topicBox').innerHTML=av.map(t=>`<label class="${G_.topics.has(t)?'on':''}${ex.includes(t)?' exam':''}"><input type="checkbox" data-t="${esc(t)}" ${G_.topics.has(t)?'checked':''}>${ex.includes(t)?'📝 ':''}${esc(t)}</label>`).join('');}
function autoTopics(){const s=cur();const av=topicsFor(G_.sub,G_.lv);const note=s?s.subjects[G_.sub].note:'';const m=matchTopics(G_.sub,G_.lv,note);
  G_.topics=new Set(m.length?m:av);renderTopics();$('topicMsg').textContent=m.length?`학생 특징에 맞춰 ${m.length}개 주제를 골랐어요.`:(note.trim()?'맞는 주제를 찾지 못해 전체 주제를 골랐어요.':'');}
function syncFromStudent(){const s=cur();if(s)G_.lv=s.subjects[G_.sub].level;else if(!SUBJECTS[G_.sub].includes(G_.lv))G_.lv=defLv(G_.sub);renderGen();autoTopics();}
$('subBtns').onclick=e=>{const b=e.target.closest('[data-sub]');if(!b)return;G_.sub=b.dataset.sub;syncFromStudent();};
$('lvSel').onchange=e=>{G_.lv=e.target.value;renderGen();autoTopics();};
$('topicBox').onchange=e=>{const t=e.target.dataset.t;if(!t)return;if(e.target.checked)G_.topics.add(t);else G_.topics.delete(t);if(!G_.topics.size){G_.topics.add(t);toast('주제를 하나 이상 골라야 해요.');}renderTopics();$('topicMsg').textContent='';};
$('autoTopic').onclick=autoTopics;
$('allTopic').onclick=()=>{G_.topics=new Set(topicsFor(G_.sub,G_.lv));renderTopics();$('topicMsg').textContent='';};
$('examTopic').onclick=()=>{const ex=(EXAM_TOPICS[G_.sub]||[]).filter(t=>topicsFor(G_.sub,G_.lv).includes(t));if(!ex.length)return;G_.topics=new Set(ex);renderTopics();$('topicMsg').textContent=`${EXAM_LABEL[G_.sub]} 주제만 골랐어요.`;};
$('baseTopic').onclick=()=>{const ex=EXAM_TOPICS[G_.sub]||[];const b=topicsFor(G_.sub,G_.lv).filter(t=>!ex.includes(t));if(!b.length)return;G_.topics=new Set(b);renderTopics();$('topicMsg').textContent='기초 학습 주제만 골랐어요.';};
document.querySelectorAll('input[name=kind]').forEach(r=>r.onchange=()=>{G_.kind=r.value;renderGen();});

/* ---------- 생성 ---------- */
let SHEETS=[],lastReq=null;
function makeSheet(s,sub,lv,kind,topics){
  const exOn=$('optEx').checked;
  if(kind==='vocab'){const r=pickWords(lv,exOn?histOf(s,'영어단어'):new Set(),50);return {sid:s?s.id:null,who:stuLabel(s),sub,lv,kind,words:r.words,notes:r.notes,recorded:false};}
  const n=+$('cntSel').value||30;const r=generate(sub,lv,{n,topics,exclude:exOn?histOf(s,sub):new Set()});
  return {sid:s?s.id:null,who:stuLabel(s),sub,lv,kind,items:r.items,notes:r.notes,recorded:false,topics:uniq(r.items.map(i=>i.topic))};
}
function doGenerate(){const s=cur();lastReq={type:'one'};SHEETS=[makeSheet(s,G_.sub,G_.lv,G_.kind,[...G_.topics])];showSheets();}
$('genBtn').onclick=doGenerate;
function doBatch(){const ids=[...document.querySelectorAll('#batchStu input:checked')].map(i=>i.value);if(!ids.length){toast('학생을 한 명 이상 고르세요.');return;}
  const sub=$('batchSub').value;const kind=sub==='영어'?document.querySelector('input[name=bkind]:checked').value:'quiz';lastReq={type:'batch'};
  SHEETS=ids.map(id=>{const s=state.students.find(x=>x.id===id);const lv=s.subjects[sub].level;const m=matchTopics(sub,lv,s.subjects[sub].note);return makeSheet(s,sub,lv,kind,m.length?m:topicsFor(sub,lv));});
  showSheets();toast(`${SHEETS.length}명의 학습지를 만들었어요.`);$('outCard').scrollIntoView({behavior:'smooth'});}
$('batchBtn').onclick=doBatch;
$('regenBtn').onclick=()=>{if(!lastReq)return;if(SHEETS.some(x=>!x.recorded)||confirm('다시 만들면 지금 문제지 대신 새 문제지가 만들어져요. 계속할까요?')){lastReq.type==='batch'?doBatch():doGenerate();}};

function renderBatchStu(){$('batchStu').innerHTML=state.students.length?state.students.map(s=>`<label style="margin-right:10px"><input type="checkbox" value="${s.id}"> ${esc(stuLabel(s))}</label>`).join(''):'<span class="muted">학생을 먼저 추가하세요.</span>';}
$('batchAll').onclick=()=>document.querySelectorAll('#batchStu input').forEach(i=>i.checked=true);
$('batchNone').onclick=()=>document.querySelectorAll('#batchStu input').forEach(i=>i.checked=false);
$('batchSub').innerHTML=SUB_LIST.map(s=>`<option>${s}</option>`).join('');
$('batchSub').onchange=()=>{$('batchKindWrap').style.display=$('batchSub').value==='영어'?'':'none';};$('batchSub').onchange();

/* ---------- 학습지 HTML ---------- */
const PB='<!--PB-->';
function head(sh,title,extra){return `<div class="sh-head"><div class="sh-title">${title} <span class="lv">${esc(sh.lv)}</span></div>
  <div class="sh-meta"><span>이름: ${sh.who?`<b>${esc(sh.who)}</b>`:'____________'}</span><span>날짜: ______ 월 ______ 일</span><span>${extra||''}</span></div></div>`;}
function qHTML(it,i){let h=`<li class="q"><span class="qn">${i+1}.</span>${it.q}`;
  if(it.type==='mc'){const long=it.choices.some(c=>strip(c).length>11);h+=`<div class="chs${long?' col':''}">`+it.choices.map((c,j)=>`<span class="ch">${CIRC[j]} ${c}</span>`).join('')+'</div>';}
  else h+='<div class="ansline">답: <span></span></div>';
  return h+'</li>';}
function quizHTML(sh,withAns){
  let h=`<div class="sheet">${head(sh,`${sh.sub} 단계별 학습지`,`점수: ______ / ${sh.items.length}`)}<div class="sh-topics">출제 영역: ${sh.topics.map(esc).join(', ')}</div><ol class="qs">${sh.items.map(qHTML).join('')}</ol></div>`;
  if(withAns){h+=PB+`<div class="sheet">${head(sh,`${sh.sub} 정답 및 해설`,'')}<table class="anst"><thead><tr><th style="width:9%">번호</th><th style="width:36%">정답</th><th>해설</th></tr></thead><tbody>`+
    sh.items.map((it,i)=>`<tr><td>${i+1}</td><td>${it.type==='mc'?`${CIRC[it.ans]} ${it.choices[it.ans]}`:it.ans}</td><td>${it.exp||''}</td></tr>`).join('')+'</tbody></table></div>';}
  return h;}
function vocabHTML(sh,withTest){
  const elem=isElem(sh.lv);const half=Math.ceil(sh.words.length/2);
  const tbl=(arr,off)=>`<table class="voc"><thead><tr><th style="width:9%">번호</th><th>단어</th>${elem?'<th>발음</th>':''}<th>뜻</th><th style="width:9%">확인</th></tr></thead><tbody>`+arr.map((w,i)=>`<tr><td class="c">${i+off+1}</td><td class="en">${esc(w.w)}</td>${elem?`<td>${esc(w.p)}</td>`:''}<td>${esc(w.k)}</td><td class="c">☐</td></tr>`).join('')+'</tbody></table>';
  let h=`<div class="sheet">${head(sh,'영어 단어장',`${sh.words.length}개`)}<div class="sh-topics">소리 내어 읽고 뜻을 외운 뒤 ☐에 표시하세요.</div><table class="wrapt"><tbody><tr><td>${tbl(sh.words.slice(0,half),0)}</td><td>${tbl(sh.words.slice(half),half)}</td></tr></tbody></table></div>`;
  if(withTest){const tt=(arr,off)=>`<table class="voc"><thead><tr><th style="width:9%">번호</th><th>단어</th><th style="width:52%">뜻 쓰기</th></tr></thead><tbody>`+arr.map((w,i)=>`<tr><td class="c">${i+off+1}</td><td class="en">${esc(w.w)}</td><td>&nbsp;</td></tr>`).join('')+'</tbody></table>';
    h+=PB+`<div class="sheet">${head(sh,'영어 단어 확인 시험',`점수: ______ / ${sh.words.length}`)}<div class="sh-topics">단어의 뜻을 우리말로 쓰세요. (정답은 단어장을 보세요.)</div><table class="wrapt"><tbody><tr><td>${tt(sh.words.slice(0,half),0)}</td><td>${tt(sh.words.slice(half),half)}</td></tr></tbody></table></div>`;}
  return h;}
function sheetHTML(sh){return sh.kind==='vocab'?vocabHTML(sh,$('vtest').checked):quizHTML(sh,$('optAns').checked);}
function allHTML(){return SHEETS.map(sheetHTML).join(PB);}
function showSheets(){
  $('previewWrap').innerHTML=allHTML().split(PB).join('<div class="pb"></div>');
  $('outBar').style.display='';
  const notes=[];SHEETS.forEach(sh=>sh.notes.forEach(n=>notes.push((SHEETS.length>1&&sh.who?`[${sh.who}] `:'')+n)));
  $('noteArea').innerHTML=notes.map(n=>`<div class="notice">${esc(n)}</div>`).join('')+(SHEETS.some(sh=>!sh.sid)?'<div class="notice info">학생을 고르지 않아서 출제 기록은 저장되지 않아요.</div>':'');
  updRec();}
function updRec(){const any=SHEETS.some(sh=>sh.sid);const done=SHEETS.every(sh=>sh.recorded||!sh.sid);$('recBtn').style.display=any?'':'none';$('recBtn').disabled=done;$('recMsg').textContent=any?(done?'출제 기록에 저장됨':'아직 출제 기록에 저장하지 않았어요'):'';}
function record(){let n=0;SHEETS.forEach(sh=>{if(sh.recorded||!sh.sid)return;const s=state.students.find(x=>x.id===sh.sid);if(!s)return;
    if(sh.kind==='vocab'){const k='영어단어';s.history[k]=uniq([...(s.history[k]||[]),...sh.words.map(w=>w.w)]);}
    else{s.history[sh.sub]=uniq([...(s.history[sh.sub]||[]),...sh.items.map(i=>i.id)]);}
    sh.recorded=true;n++;});
  if(n){save();renderStudents();renderStuPanel();toast(`${n}장의 출제 기록을 저장했어요.`);}updRec();}
$('recBtn').onclick=record;
$('printBtn').onclick=()=>{if(!SHEETS.length)return;if($('optRec').checked)record();window.print();};
$('wordBtn').onclick=()=>{if(!SHEETS.length)return;if($('optRec').checked)record();
  const css=document.querySelector('style').textContent.split('/* ===== 학습지 ===== */')[1].split('@media print')[0]+'ol.qs{columns:1}.sheet{width:auto;padding:0;box-shadow:none}';
  const body=allHTML().split(PB).join("<br clear=all style='mso-special-character:line-break;page-break-before:always'>");
  const html=`<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40"><head><meta charset="utf-8"><title>학습지</title><!--[if gte mso 9]><xml><w:WordDocument><w:View>Print</w:View><w:Zoom>100</w:Zoom></w:WordDocument></xml><![endif]--><style>@page{size:21cm 29.7cm;margin:1.6cm 1.5cm}body{font-family:"맑은 고딕","Malgun Gothic",sans-serif;font-size:10.5pt}${css}</style></head><body>${body}</body></html>`;
  const blob=new Blob(['﻿',html],{type:'application/msword'});const a=document.createElement('a');
  const first=SHEETS[0];const nm=SHEETS.length>1?`${first.sub}_학습지_${SHEETS.length}명`:`${first.who||'학습지'}_${first.sub}_${first.lv}${first.kind==='vocab'?'_단어장':''}`;
  a.href=URL.createObjectURL(blob);a.download=nm.replace(/[\\/:*?"<>|\s]+/g,'_')+'.doc';document.body.appendChild(a);a.click();setTimeout(()=>{URL.revokeObjectURL(a.href);a.remove();},500);};

/* ---------- 백업 ---------- */
$('exportBtn').onclick=()=>{const blob=new Blob([JSON.stringify(state,null,1)],{type:'application/json'});const a=document.createElement('a');a.href=URL.createObjectURL(blob);
  const d=new Date();a.download=`기초학력_학생기록_${d.getFullYear()}${String(d.getMonth()+1).padStart(2,'0')}${String(d.getDate()).padStart(2,'0')}.json`;document.body.appendChild(a);a.click();setTimeout(()=>a.remove(),300);};
$('importBtn').onclick=()=>$('importFile').click();
$('importFile').onchange=e=>{const f=e.target.files[0];if(!f)return;const r=new FileReader();r.onload=()=>{try{const o=JSON.parse(r.result);if(!o||!Array.isArray(o.students))throw 0;
  if(state.students.length&&!confirm('지금 목록을 백업 파일 내용으로 바꿀까요?'))return;state=o;save();renderAll();syncFromStudent();toast('백업을 불러왔어요.');}catch(err){alert('백업 파일을 읽지 못했어요.');}};r.readAsText(f);e.target.value='';};

function renderAll(){renderStudents();renderStuPanel();syncFromStudent();}
load();save();renderAll();

</script>
</body>
</html>
