for(const lv of LV9){WORDS[lv]=WRAW[lv].split(';').map(s=>s.trim()).filter(Boolean).map(s=>{const [w,k,p]=s.split('|');return {w,k,p:p||''};}).filter(x=>x.w&&x.k&&/^[A-Za-z ]+$/.test(x.w));}
const isElem=lv=>lv.startsWith('초등');

function pickWords(lv,exclude,n){
  const notes=[];let out=WORDS[lv].filter(x=>!exclude.has(x.w));
  const i=LV9.indexOf(lv);
  if(out.length<n){const order=[];for(let d=1;d<9;d++){if(i+d<9)order.push(i+d);if(i-d>=0)order.push(i-d);}
    for(const j of order){if(out.length>=n)break;const more=WORDS[LV9[j]].filter(x=>!exclude.has(x.w)).slice(0,n-out.length).map(x=>({...x,from:LV9[j]}));if(more.length){notes.push(`${lv} 단어를 모두 배부해서 ${LV9[j]} 단어 ${more.length}개를 함께 넣었어요.`);out=out.concat(more);}}}
  if(out.length<n){const re=WORDS[lv].filter(x=>!out.includes(x)).slice(0,n-out.length);notes.push(`모든 단어를 배부해서 이전에 배부한 단어 ${re.length}개를 다시 넣었어요.`);out=out.concat(re);}
  return {words:out.slice(0,n),notes};
}

